PORT=4000
CURRENCY="INR"
JWT_SECRET="your_jwt_secret_key_here"

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# Admin Panel Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_admin_password_here"
ADMIN_PASSWORD_HASH=""

# MongoDB Connection (Local or Atlas)
MONGODB_URI="mongodb://127.0.0.1:27017"

# Cloudinary Setup (Doctor profile pictures and assets)
CLOUDINARY_NAME="your_cloudinary_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_SECRET_KEY="your_cloudinary_secret_key"

# Razorpay Payment Integration
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Stripe Payment Integration
STRIPE_SECRET_KEY="your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# Automated Refund Reconciliation Scheduler Configuration
REFUND_RECONCILER_INTERVAL_MIN=15
REFUND_RECONCILER_BATCH_SIZE=20

# Email Notifications (Nodemailer SMTP Configuration)
# If unconfigured, email alerts are safely skipped without breaking any application workflows.
# For Gmail:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=587
#   SMTP_USER="your-email@gmail.com"
#   SMTP_PASS="xxxx xxxx xxxx xxxx"  (16-character Google App Password from myaccount.google.com/apppasswords)
#   SMTP_FROM='"Prescripto Healthcare" <your-email@gmail.com>'
# For Brevo (Sendinblue):
#   SMTP_HOST="smtp-relay.brevo.com"
#   SMTP_PORT=587
#   SMTP_USER="your-brevo-login"
#   SMTP_PASS="your-brevo-smtp-key"
#   SMTP_FROM='"Prescripto Healthcare" <noreply@yourdomain.com>'
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# WebRTC Video Consultation Configuration
# STUN servers (defaults to Google free public STUN if empty)
RTC_STUN_SERVER="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# Optional TURN Relay Server (for restrictive enterprise firewalls and symmetric NATs)
# Can use Metered, Twilio, Xirsys, or self-hosted coturn
RTC_TURN_SERVER=""
RTC_TURN_USERNAME=""
RTC_TURN_CREDENTIAL=""

# Video Consultation Joining Window (in minutes)
VIDEO_JOIN_WINDOW_BEFORE_MINUTES=60
VIDEO_JOIN_WINDOW_AFTER_MINUTES=240
# Set to true to bypass slot time window checks during development/testing
VIDEO_DISABLE_TIME_CHECK="false"

# AI Doctor Recommendation Service (Optional)
# If unconfigured or unavailable, the system automatically uses deterministic local keyword triage with zero downtime.
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
# AI Model identifier (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"
# Optional custom AI endpoint override
AI_API_URL=""
